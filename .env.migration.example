# Environment Variables for Database Migration
# Copy this file to .env and fill in your actual values

# Render Database URL - REQUIRED for migration
# Get this from your Render dashboard -> PostgreSQL -> Info -> Connection string
RENDER_DATABASE_URL=postgresql://user:password@host.render.com/database

# Optional: Local Database URL (default is set in script)
# LOCAL_DATABASE_URL=postgresql://postgres:11223344@localhost:5432/FlaskWebPostgreSQL

# Optional: Application Environment
# FLASK_ENV=production
# SECRET_KEY=your-secret-key
